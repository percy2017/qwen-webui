<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Qwen Web Agent</title>
    <link rel="shortcut icon" href="/img/logo.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.16/themes/default-dark/style.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/tokyo-night-dark.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/tokyo-night.min.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>

<body>

    <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">
                <img src="/img/logo.png" alt="Qwen Logo" height="24">
                Web Agent
            </a>
            <div class="ms-auto">
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="userOptions"
                        data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-2"></i>
                        <span id="user-alias">Perfil</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userOptions">
                        <li hidden>
                            <div class="px-3 py-2 text-center">
                                <h6 class="mb-0" id="user-dropdown-name" >Cargando...</h6>
                                <small class="text-muted" id="user-dropdown-alias">...</small>
                            </div>
                        </li>
                        <li>
                            <div class="px-3 py-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>Gasto:</span>
                                    <strong id="user-dropdown-spend">$0.00</strong>
                                </div>
                                <div class="d-flex justify-content-between small">
                                    <span>Presupuesto:</span>
                                    <strong id="user-dropdown-budget">N/A</strong>
                                </div>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" id="settings-btn"><i class="bi bi-gear-fill me-2"></i>Ajustes</a></li>
                        <li><a class="dropdown-item text-danger" href="#" id="logout-btn"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <main class="main-container">

        <aside class="sidebar" id="left-sidebar">
            <div class="sidebar-header d-flex justify-content-between align-items-center">
                <h5>👨‍🏭 Proyectos</h5>
                <!-- Botón para crear un nuevo proyecto -->
                <button class="btn btn-sm btn-outline-secondary" id="new-project-btn" title="Nuevo Proyecto">
                    <i class="bi bi-plus-lg"></i>
                </button>
            </div>
            
            <!-- Contenedor del Acordeón para la lista de proyectos -->
            <div class="accordion accordion-flush" id="projects-accordion">
                <!-- Los proyectos se añadirán aquí dinámicamente como items del acordeón -->
                <div class="text-muted p-3">Cargando...</div>
            </div>
        </aside>

        <section class="main-content" id="editor-container">
            <div id="editor-tabs" class="editor-tabs border-bottom d-flex"></div>
            <div class="editor-area">
                <div id="welcome-message" class="d-flex h-100 align-items-center justify-content-center text-muted">
                    <div class="text-center">
                        <i class="bi bi-file-earmark-code" style="font-size: 4rem;"></i>
                        <h4 class="mt-3">Aún no hay archivos abiertos</h4>
                        <p>Selecciona un archivo del explorador para verlo o editarlo.</p>
                    </div>
                </div>
                <div id="code-editor-wrapper" class="d-none h-100"></div>
                <button class="btn btn-primary position-absolute bottom-0 end-0 m-3 d-none" id="save-file-btn">
                    <i class="bi bi-save me-2"></i>Guardar Cambios
                </button>
            </div>
        </section>
        <aside class="sidebar" id="right-sidebar">
            <div class="sidebar-header">
                <h5>🤖 Asistente</h5>
            </div>
            <div class="chat-history-container flex-grow-1" id="chat-history"></div>

            <div class="chat-input-area p-2 border-top">
                <form id="chat-form" class="d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary me-2" id="attach-file-btn"
                        title="Adjuntar archivo">
                        <i class="bi bi-paperclip"></i>
                    </button>
                    <textarea id="user-input" class="form-control" rows="1"
                        placeholder="Escribe tu comando o pregunta..."></textarea>
                    <button type="submit" class="btn btn-primary ms-2" id="send-btn" title="Enviar">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </form>
            </div>
            <div class="chat-status-bar d-flex justify-content-between align-items-center p-2 border-top">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="agent-mode-switch">
                    <label class="form-check-label small" for="agent-mode-switch" id="agent-mode-label">Modo
                        Arquitecto</label>
                </div>
                <div class="small text-muted" id="active-llm-indicator">
                    <i class="bi bi-robot"></i>
                    <span>Cargando...</span>
                </div>
            </div>
        </aside>

    </main>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/css/css.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/xml/xml.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/htmlmixed/htmlmixed.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/markdown/markdown.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.16/jstree.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>    
    <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/admin.js"></script>

    <%- include('partials/modal-settings') %>
    <%- include('partials/modal-new-project') %>
</body>

</html>