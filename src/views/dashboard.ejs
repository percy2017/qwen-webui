<%- include('partials/header') %>

<div class="main-wrapper" id="dashboard">
    <!-- Sidebar -->
    <nav id="sidebar" class="d-flex flex-column p-3 bg-body-tertiary" style="width: 280px;">
        <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-decoration-none">
            <img src="/img/logo.png" alt="Logo" width="32" height="32" class="me-2">
            <span class="fs-4">Qwen WebUI</span>
        </a>
        <hr>
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a href="#" class="nav-link" id="newProjectLink">
                    <i class="bi bi-plus-circle me-2"></i> Proyecto
                </a>
            </li>
            <li>
                <a href="#" class="nav-link" id="settingsLink">
                    <i class="bi bi-gear me-2"></i> Ajustes
                </a>
            </li>
        </ul>
        <h6 class="sidebar-heading px-3 mt-4 mb-1 text-muted text-uppercase">
            <span>Mis Proyectos</span>
        </h6>
        <ul class="nav flex-column" id="projectsList">
            <li class="nav-item"><a class="nav-link disabled" href="#">Cargando...</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <main>
        <div class="main-content p-4">
            <div class="row g-4">
                <!-- Columna Izquierda: Terminal de Chat -->
                <div class="col-12 col-lg-8 chat-column">
                    <div class="card shadow-sm chat-card">
                        <div class="card-header">
                            <strong id="chat-header">Terminal de Interacción</strong>
                        </div>
                        <div class="card-body chat-card-body p-0">
                            <div id="chat-history" class="p-3">
                                <!-- El historial del chat se renderizará aquí -->
                            </div>
                        </div>
                        <div class="card-footer p-3">
                         <div class="input-group">
    <button class="btn btn-outline-secondary" type="button" id="attach-file-btn" disabled>
        <i class="bi bi-paperclip"></i>
    </button>
    <input type="file" id="file-input" class="d-none">
    <textarea class="form-control" id="userInput" placeholder="Escribe tu comando o pregunta..." rows="1" style="resize: none; overflow-y: hidden;" disabled></textarea>
    <button class="btn btn-primary" type="button" id="sendBtn" disabled>
        <i class="bi bi-send"></i>
    </button>
</div>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Paneles de Información -->
                <div class="col-12 col-lg-4 info-column">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header"><strong>Información del Usuario</strong></div>
                        <div class="card-body" id="userInfoPanel">
                            <p class="text-muted">Cargando datos...</p>
                        </div>
                    </div>
                    <div class="card shadow-sm mb-4">
                        <div class="card-header"><strong>Información del Proyecto</strong></div>
                        <div class="card-body" id="projectContextPanel">
                            <p class="text-muted">Selecciona un proyecto para ver sus detalles.</p>
                        </div>
                    </div>
                    <div class="card shadow-sm mb-4">
                        <div class="card-header"><strong>Estado del Agente</strong></div>
                        <div class="card-body" id="projectStatusPanel">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-robot me-2"></i>LLM Activo</span>
                                    <strong id="selectedModel">-</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-hdd-stack me-2"></i>Estado</span>
                                    <span class="badge bg-secondary" id="projectStatus">Inactivo</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header"><strong>Log del Sistema</strong></div>
                        <div class="card-body p-0">
                            <div id="system-terminal-log" class="p-3" style="height: 150px; overflow-y: auto; font-family: monospace; font-size: 0.85em;">
                                <!-- Mensajes del sistema -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- Modales -->
<%- include('partials/modal-settings') %>
<%- include('partials/modal-new-project') %>

<%- include('partials/footer') %>