<%- include('partials/header') %>

<style>
    /* Estilos específicos para la página de login */
    body {
        /* Centra el contenido verticalmente en toda la página */
        display: flex;
        align-items: center;
        padding-top: 40px;
        padding-bottom: 40px;
        background-color: var(--bs-tertiary-bg); /* Un fondo suave para la página */
    }

    .form-signin {
        max-width: 400px;
        padding: 2rem;
        background-color: var(--bs-body-bg);
        border-radius: var(--bs-border-radius-lg);
    }
    
    .logo-container {
        /* Centra el logo y le da espacio */
        margin-bottom: 2rem;
        text-align: center;
    }

    .logo-container img {
        /* Ajusta el tamaño del logo */
        max-width: 100px;
        height: auto;
    }
</style>

<main class="form-signin w-100 m-auto">
    
    <!-- Contenedor del Logo -->
    <div class="logo-container">
        <img src="/img/logo.png" alt="Logo de Qwen Web Agent">
    </div>

    <form id="loginForm">
        <h1 class="h3 mb-3 fw-normal text-center">Qwen WebUI</h1>
        <!-- <p class="text-center text-muted mb-4"></p> -->

        <div class="form-floating mb-3">
            <input type="url" class="form-control" id="litellmUrl" 
                   placeholder="https://litellm.endpoint.com" 
                   value="" required>
            <label for="litellmUrl">
                <i class="bi bi-link-45deg me-1"></i>URL de LiteLLM
            </label>
        </div>

        <div class="form-floating mb-3">
            <input type="password" class="form-control" id="apiKey" 
                   placeholder="sk-..." required>
            <label for="apiKey">
                <i class="bi bi-key me-1"></i>LiteLLM API Key
            </label>
            <!-- El botón de mostrar/ocultar contraseña necesita JS para funcionar.
                 Lo he dejado como estaba, pero el estilo flotante lo mejora. -->
        </div>

        <div class="form-check text-start my-3">
            <input class="form-check-input" type="checkbox" id="rememberMe">
            <label class="form-check-label" for="rememberMe">
                Recuérdame
            </label>
        </div>

        <button class="btn btn-primary w-100 py-2" type="submit">
            <i class="bi bi-box-arrow-in-right me-2"></i>
            Conectar
        </button>
        
        <!-- Alerta para mostrar errores, oculta por defecto -->
        <div id="loginAlert" class="alert alert-danger mt-3 d-none" role="alert"></div>

    </form>
    
    <p class="mt-4 text-body-secondary text-center">
        <small>Necesitas una instancia de <a href="https://litellm.iptvbolivia.com" target="_blank" class="text-decoration-none">LiteLLM</a> para continuar.</small>
    </p>

</main>

<%- include('partials/footer') %>