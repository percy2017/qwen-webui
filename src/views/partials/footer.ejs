<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.3/dist/sweetalert2.all.min.js"></script>
<!-- Socket.IO Client -->
<script src="/socket.io/socket.io.js"></script>
<!-- Feather Icons -->
<script src="https://unpkg.com/feather-icons"></script>

<!-- Nuestro Módulo Principal de JavaScript -->
<script type="module" src="/js/main.js"></script>

<!-- Tema para Highlight.js (Atom One Dark). Debe ir en el <head> idealmente, pero funciona aquí. -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
<!-- Librería para convertir Markdown a HTML -->
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<!-- Librería para resaltar sintaxis -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

<!-- Script de configuración para que Marked use Highlight.js -->
<script>
    // Configuración global para que Marked use Highlight.js para los bloques de código
    marked.setOptions({
        highlight: function (code, lang) {
            const language = hljs.getLanguage(lang) ? lang : 'plaintext';
            return hljs.highlight(code, { language }).value;
        },
        langPrefix: 'hljs language-' // Usa las clases CSS de highlight.js
    });
</script>
</body>
</html>